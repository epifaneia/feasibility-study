# Copia este archivo a .env y rellena los valores.

# --- Gemini (deep research y extracción) ---
# Clave de API: https://aistudio.google.com/apikey
GEMINI_API_KEY=tu_api_key_aqui
# GEMINI_MODELO_EXTRACCION=gemini-3.1-pro-preview
# RESEARCH_TIMEOUT_S=2700

# --- Contacto del consultor (bloque "Siguiente paso" del informe; vacío = sin línea) ---
CONTACTO_NOMBRE=
CONTACTO_EMAIL=
CONTACTO_TEL=

# --- Ajuste de longitud con Qwen local (Ollama). 0 para desactivarlo ---
LONGITUD_QWEN=1
# QWEN_MODELO=qwen2.5:7b

# --- Custodia: los tres cables de integración (docs/INTEGRATION.md) ---
# CUSTODIA_ACTOR: obligatorio, el servidor no arranca sin actor (p. ej. ana.garcia)
CUSTODIA_ACTOR=
# CUSTODIA_LEDGER: libro de custodia, una línea JSON por llamada a un modelo (o - para stdout)
CUSTODIA_LEDGER=logs/custody.jsonl
# CUSTODIA_SIGNING_KEY: clave local de firma de informes; la empresa la sustituye por su PKI
CUSTODIA_SIGNING_KEY=
